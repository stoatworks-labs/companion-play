#!/usr/bin/env bash
# Install the udev rules Companion generates at runtime for surface devices.
#
# Companion 4.3+ stopped shipping a static rules file and writes one into its
# own config directory instead, then asks the OS to install it via
# COMPANION_SYNC_UDEV_RULES_COMMAND. This is that command, and it is the only
# thing the service account is allowed to run as root besides power control.
#
# Taken from companion-pi with one change: the home directory lookup is the
# whole point here, because companion-play puts the service account's home on
# the state partition rather than in /home.

set -e

if [[ $(/usr/bin/id -u) -ne 0 ]]; then
    echo "Must be run as root. Try sudo companion-sync-udev-rules"
    exit 1
fi

ACTUAL_HOME=$(getent passwd "companion" | cut -d: -f6)

CONFIG_DIR="$ACTUAL_HOME/companion"
if ! [ -d "$CONFIG_DIR" ]; then
    CONFIG_DIR="$ACTUAL_HOME/.config/companion-nodejs"
fi

SOURCE_FILE="$CONFIG_DIR/udev-rules/50-companion-headless.rules"
if ! [ -f "$SOURCE_FILE" ]; then
    echo "No udev rules file found at $SOURCE_FILE. Nothing to sync"
    exit 1
fi

cp "$SOURCE_FILE" /etc/udev/rules.d/50-companion.rules
udevadm control --reload-rules || true
udevadm trigger --subsystem-match=usb || true

echo "udev rules sync is complete"
